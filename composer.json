{
    "require": {
        "ext-pdo": "*",
        "vlucas/phpdotenv": "^5.3",
        "doctrine/dbal": "^3.2",
        "doctrine/orm": "^2.11",
        "symfony/cache": "^6.4",
        "doctrine/annotations": "^1.0",
        "doctrine/migrations": "^3.8",
        "ext-curl": "*",
        "guzzlehttp/guzzle": "^7.9",
        "twig/twig": "^3.20",
        "twig/intl-extra": "^3.20",
        "slim/slim": "4.*",
        "slim/psr7": "^1.7",
        "slim/twig-view": "^3.3",
        "php-di/php-di": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    }
}
